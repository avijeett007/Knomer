    },
    {
      "name": "Pre-request Scripts",
      "item": [
        {
          "name": "Generate Sample URLs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Run to generate sample URLs for v2 endpoints"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This script helps generate sample URLs based on the environment",
                  "// These can then be used in the v2 endpoints that require URLs",
                  "",
                  "// Base URL for sample files",
                  "const sampleBaseUrl = pm.variables.get('sample_files_url') || 'https://example-videos.s3.amazonaws.com';",
                  "",
                  "// Set sample URLs if not already set",
                  "if (!pm.environment.get('sample_video_url')) {",
                  "    pm.environment.set('sample_video_url', sampleBaseUrl + '/samples/sample1.mp4');",
                  "}",
                  "",
                  "if (!pm.environment.get('sample_video_url2')) {",
                  "    pm.environment.set('sample_video_url2', sampleBaseUrl + '/samples/sample2.mp4');",
                  "}",
                  "",
                  "if (!pm.environment.get('sample_video_url3')) {",
                  "    pm.environment.set('sample_video_url3', sampleBaseUrl + '/samples/sample3.mp4');",
                  "}",
                  "",
                  "if (!pm.environment.get('sample_logo_url')) {",
                  "    pm.environment.set('sample_logo_url', sampleBaseUrl + '/logos/logo.png');",
                  "}",
                  "",
                  "if (!pm.environment.get('transition_url')) {",
                  "    pm.environment.set('transition_url', sampleBaseUrl + '/transitions/wipe.mp4');",
                  "}",
                  "",
                  "console.log('Sample URLs generated for v2 endpoints testing');",
                  "console.log('sample_video_url: ' + pm.environment.get('sample_video_url'));",
                  "console.log('sample_logo_url: ' + pm.environment.get('sample_logo_url'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
