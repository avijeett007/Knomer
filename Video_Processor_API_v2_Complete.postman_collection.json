                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users"]
            },
            "description": "Create a new user with initial credits"
          },
          "response": []
        },
        {
          "name": "Provision Monthly Credits",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "credits_amount",
                  "value": "5000",
