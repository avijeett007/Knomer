# Video Processing API Environment Configuration

# API Configuration
API_TITLE="Video Processing API"
API_VERSION="2.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Security
SECRET_KEY="your-secret-key-here-change-this-in-production"
JWT_SECRET="your-jwt-secret-here-change-this-in-production"
JWT_ALGORITHM="HS256"
API_KEY_PREFIX="vp_"

# Database Configuration (Supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_KEY="your-service-key-here"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Celery Configuration
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Storage Configuration
STORAGE_BUCKET="video-processing"
TEMP_STORAGE_PATH="/tmp/video_processing"

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_MINUTE=10
DEFAULT_RATE_LIMIT_PER_HOUR=100
DEFAULT_RATE_LIMIT_PER_DAY=1000

# Credit System
CREDITS_PER_10_SECONDS=1
FREE_TIER_CREDITS=100

# Processing Configuration
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEOS_PER_JOB=10
PROCESSING_TIMEOUT_SECONDS=1800

# File Cleanup
TEMP_FILE_CLEANUP_HOURS=1
OUTPUT_FILE_RETENTION_DAYS=7

# External Services
OPENAI_API_KEY="your-openai-api-key-for-whisper"

# Development
PYTHONUNBUFFERED=1
